<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="RapiTwistArcPulseTemplate" virtual="true" alpha="0">
        <Animations>
            <AnimationGroup autoplay="true" setToFinalAlpha="true">
                <Alpha order="1" fromAlpha="0" toAlpha="1" duration="0.10"/>
                <Alpha order="2" fromAlpha="1" toAlpha="0" duration="0.28" smoothing="OUT"/>
            </AnimationGroup>
        </Animations>
    </Frame>
    <Frame name="RapiTwistWaitGateTemplate" virtual="true">
        <Animations>
            <AnimationGroup parentKey="Mute" autoplay="true" looping="REPEAT">
                <Alpha parentKey="WaitAlpha" fromAlpha="0" toAlpha="0" duration="1"/>
            </AnimationGroup>
        </Animations>
    </Frame>
</Ui>
